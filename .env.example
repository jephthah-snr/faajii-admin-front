# anything else selects NEXT_PUBLIC_STAGING_BASE_URL.
NEXT_PUBLIC_ENVIRONMENT=staging

NEXT_PUBLIC_STAGING_BASE_URL=https://faajiii-backend-staging-344535634654.up.railway.app
NEXT_PUBLIC_PROD_BASE_URL=

# Legacy single-environment name. Kept as a fallback in getBaseUrl so an
# environment that has not been migrated to the split names above still works.
NEXT_PUBLIC_BASE_URL=https://faajiii-backend-staging-344535634654.up.railway.app
